# ChargeVeta console — local configuration.
#
# Copy to `.env.local` and fill in. Never put a real secret in this file: it is
# committed, and everything a browser build can read is public anyway. Anything
# genuinely secret belongs to the API, not here.

# Where the monolith's REST API lives, including its prefix and version. The
# API listens on 9010 in development (doc 4 §12).
NEXT_PUBLIC_API_BASE_URL=http://localhost:9010/api/v1

# The Socket.IO endpoint the API serves when REALTIME_ENABLED is on, and the
# path it is mounted at (the monolith's REALTIME_PATH). The origin is the API's
# own, without the /api/v1 prefix. Leave the origin empty to turn live updates
# off in this build; the console then falls back to refetching on an interval.
#
# Opened from another host (a phone through the dev tunnel), a localhost URL
# here is ignored and the socket goes to the page's own origin at
# NEXT_PUBLIC_REALTIME_PATH instead — the tunnel routes that path to the API.
NEXT_PUBLIC_REALTIME_URL=http://localhost:9010
NEXT_PUBLIC_REALTIME_PATH=/realtime

# Development only: hostnames besides localhost that `npm run dev` serves its
# dev resources (/_next/*, hot reload) to, comma-separated, `*.` wildcards
# allowed. Unset means charveta.appme.in, the dev tunnel; set it empty to allow
# localhost only. Restart `npm run dev` after changing it.
DEV_ALLOWED_ORIGINS=charveta.appme.in

# The name shown in the browser tab and on the sign-in screen.
NEXT_PUBLIC_APP_NAME=ChargeVeta

# How many proxies stand in front of this server, each appending the address it
# saw to X-Forwarded-For (charveta doc 6 §18.4). The console then tells the API
# the browser's address — the entry that many from the right — instead of its
# own; the API believes it only from peers in its TRUSTED_PROXY_CIDRS. 0 (the
# default) forwards nothing: with no proxy in front, Next passes on whatever
# X-Forwarded-For the browser sent, so there is nothing to vouch for. The dev
# tunnel (Cloudflare, then cloudflared, which adds nothing) is 1. With N > 0,
# keep this port off the network: a request that bypasses the proxies picks
# its own recorded address.
TRUSTED_PROXY_HOPS=0
